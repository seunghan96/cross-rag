    "if USE_ACTUAL_RETRIEVAL:\n",
    "    try:\n",
    "        embedding_model = get_embedding_model()\n",
    "        retrieved_df_z_faiss, timing_z = do_retrieve_Z_faiss(\n",
    "            original_data_name=DATASET_NAME,\n",
    "            retrieval_database_dir=RETRIEVAL_DATABASE_DIR,\n",
    "            root_dir=ROOT_DIR,\n",
    "            metadata=metadata,\n",
    "            mode='only_self_train',\n",
    "            top_k=NUM_RETRIEVED,\n",
    "            context_length=CONTEXT_LENGTH,\n",
    "            prediction_length=PREDICTION_LENGTH,\n",
    "            seed=SEED,\n",
    "            dimension=768,\n",
    "            embedding_model=embedding_model,\n",
    "            save=True,\n",
    "            embedding_tuning=EMBEDDING_TUNING,\n",
    "            retrieve_suffix=\"Z_faiss\"\n",
    "        )\n",
    "        retrieval_timings['Z-space'] = timing_z\n",
    "        print(f\"✓ Z-space retrieval completed\")\n",
    "    except Exception as e:\n",
    "        print(f\"✗ Z-space retrieval failed: {e}\")\n",
    "        import traceback\n",
    "        traceback.print_exc()\n",
    "        retrieval_timings['Z-space'] = None\n",
    "else:\n",
    "    print(\"Skipped (USE_ACTUAL_RETRIEVAL=False)\")\n",
    "\n",
    "# X-space retrieval (no embedding, FAISS only)\n",
    "print(\"\\n[2/2] Running X-space retrieval (No embedding + FAISS)...\")\n",
    "if USE_ACTUAL_RETRIEVAL:\n",
    "    try:\n",
    "        retrieved_df_x_faiss, timing_x = do_retrieve_X_faiss(\n",
    "            original_data_name=DATASET_NAME,\n",
    "            retrieval_database_dir=RETRIEVAL_DATABASE_DIR,\n",
    "            root_dir=ROOT_DIR,\n",
    "            metadata=metadata,\n",
    "            mode='only_self_train',\n",
    "            top_k=NUM_RETRIEVED,\n",
    "            context_length=CONTEXT_LENGTH,\n",
    "            prediction_length=PREDICTION_LENGTH,\n",
    "            seed=SEED,\n",
    "            metric=METRIC,\n",
    "            save=True,\n",
    "            retrieve_suffix=\"X_faiss\"\n",
    "        )\n",
    "        retrieval_timings['X-space'] = timing_x\n",
    "        print(f\"✓ X-space retrieval completed\")\n",
    "    except Exception as e:\n",
    "        print(f\"✗ X-space retrieval failed: {e}\")\n",
    "        import traceback\n",
    "        traceback.print_exc()\n",
    "        retrieval_timings['X-space'] = None\n",
    "else:\n",
    "    print(\"Skipped (USE_ACTUAL_RETRIEVAL=False)\")\n",
    "\n",
    "# Display comparison\n",
    "print(\"\\n\" + \"=\"*80)\n",
    "print(\"RETRIEVAL TIMING COMPARISON\")\n",
    "print(\"=\"*80)\n",
    "\n",
    "if retrieval_timings.get('Z-space') and retrieval_timings.get('X-space'):\n",
    "    timing_z = retrieval_timings['Z-space']\n",
    "    timing_x = retrieval_timings['X-space']\n",
    "    \n",
    "    print(f\"\\nZ-space (Embedding + FAISS):\")\n",
    "    print(f\"  DB Embedding time: {timing_z['embedding_time']:.2f} seconds\")\n",
    "    print(f\"  FAISS Search time: {timing_z['search_time']:.2f} seconds\")\n",
    "    print(f\"  Total time:        {timing_z['total_time']:.2f} seconds\")\n",
    "    \n",
    "    print(f\"\\nX-space (No embedding + FAISS):\")\n",
    "    print(f\"  DB Embedding time: {timing_x['embedding_time']:.2f} seconds (no embedding)\")\n",
    "    print(f\"  FAISS Search time: {timing_x['search_time']:.2f} seconds\")\n",
    "    print(f\"  Total time:        {timing_x['total_time']:.2f} seconds\")\n",
    "    \n",
    "    print(f\"\\nSpeedup Analysis:\")\n",
    "    speedup_total = timing_z['total_time'] / timing_x['total_time'] if timing_x['total_time'] > 0 else 0\n",
    "    speedup_search = timing_z['search_time'] / timing_x['search_time'] if timing_x['search_time'] > 0 else 0\n",
    "    embedding_overhead = timing_z['embedding_time'] / timing_z['total_time'] * 100 if timing_z['total_time'] > 0 else 0\n",
    "    \n",
    "    print(f\"  X-space is {speedup_total:.2f}x faster (total time)\")\n",
    "    print(f\"  X-space is {speedup_search:.2f}x faster (search time only)\")\n",
    "    print(f\"  Embedding overhead: {embedding_overhead:.1f}% of Z-space total time\")\n",
    "    \n",
    "    # Store for later use\n",
    "    retrieval_efficiency_results = {\n",
    "        'Z-space': timing_z,\n",
    "        'X-space': timing_x,\n",
    "        'speedup_total': speedup_total,\n",
    "        'speedup_search': speedup_search,\n",
    "        'embedding_overhead_percent': embedding_overhead\n",
    "    }\n",
    "else:\n",
    "    print(\"Timing comparison not available (one or both retrievals failed)\")\n",
    "    retrieval_efficiency_results = None\n",
    "\n",
    "print(\"=\"*80)"
