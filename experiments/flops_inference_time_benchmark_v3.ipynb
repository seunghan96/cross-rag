    "            root_dir=ROOT_DIR,\n",
    "            metadata=metadata,\n",
    "            mode='only_self_train',\n",
    "            top_k=NUM_RETRIEVED,\n",
    "            context_length=CONTEXT_LENGTH,\n",
    "            prediction_length=PREDICTION_LENGTH,\n",
    "            seed=SEED,\n",
    "            dimension=768,\n",
    "            embedding_model=embedding_model,\n",
    "            save=True,\n",
    "            embedding_tuning=EMBEDDING_TUNING,\n",
    "            retrieve_suffix=\"Z_faiss\"\n",
    "        )\n",
    "        retrieval_timings['Z-space'] = timing_z\n",
    "        print(f\"✓ Z-space retrieval completed\")\n",
