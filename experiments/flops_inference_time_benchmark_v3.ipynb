    "    sys.modules['ts_rag.models.ChronosBolt_TabPFN_dualhead_R_as_key'] = tabpfn_dualhead_module\n",
    "    tabpfn_dualhead_spec.loader.exec_module(tabpfn_dualhead_module)\n",
    "\n",
    "from ts_rag.models.ChronosBolt_TabPFN_dualhead_R_as_key import (\n",
    "    ChronosBoltModelForForecastingWithRetrieval as TabPFNDualheadModel,\n",
    "    ChronosBoltPipelineWithRetrieval as TabPFNDualheadPipeline\n",
    ")\n",
    "\n",
    "Model1, Model2, Model3, Model4, Model5, Model6 = models_list\n",
    "Pipeline1, Pipeline2, Pipeline3, Pipeline4, Pipeline5, Pipeline6 = pipelines_list\n",
    "\n",
    "MODEL_NAMES = [\n",
    "    \"cross_self\",\n",
    "    \"cross\",\n",
    "    \"main_cross\",\n",
    "    \"main_self\",\n",
