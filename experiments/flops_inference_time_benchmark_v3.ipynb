    "def load_retrieved_data(dataset_name, root_dir, context_length, prediction_length, metadata, retrieve_suffix, use_z_space=False, embedding_model=None, embedding_tuning=None):\n",
    "    \"\"\"Load retrieved data from CSV file\n",
    "    \n",
    "    Args:\n",
    "        use_z_space: If True, use retrieve_Z, else use retrieve_X_norm\n",
    "        embedding_model: Required if use_z_space=True\n",
    "        embedding_tuning: Optional, for Z-space retrieval\n",
    "    \"\"\"\n",
    "    retrieval_database_names = '_'.join(metadata['database_name'])\n",
    "    suffix = retrieve_suffix if retrieve_suffix else ''\n",
    "    suffix = suffix if suffix == '' else f'_{suffix}'\n",
    "    \n",
    "    # Different file naming for Z-space vs X-space\n",
    "    if use_z_space:\n",
    "        embedding_tuning_str = embedding_tuning if embedding_tuning else 'None'\n",
    "        retrieved_data_path = os.path.join(\n",
    "            root_dir, \n",
    "            f'{dataset_name}_retrieve_{retrieval_database_names}_{metadata[\"lookback_length\"]}_only_self_train_{embedding_tuning_str}{suffix}.csv'\n",
    "        )\n",
    "    else:\n",
    "        retrieved_data_path = os.path.join(\n",
    "            root_dir, \n",
    "            f'{dataset_name}_retrieve_{retrieval_database_names}_{metadata[\"lookback_length\"]}_only_self_train_None{suffix}.csv'\n",
    "        )\n",
    "    \n",
    "    #if not os.path.exists(retrieved_data_path):\n",
    "    print(f'Retrieved data not found at {retrieved_data_path}')\n",
    "    print('Performing retrieval...')\n",
    "    # Perform retrieval\n",
    "    if use_z_space:\n",
    "        if embedding_model is None:\n",
    "            raise ValueError(\"embedding_model is required for Z-space retrieval\")\n",
    "        retrieved_df = do_retrieve_Z(\n",
    "            original_data_name=dataset_name,\n",
    "            retrieval_database_dir=RETRIEVAL_DATABASE_DIR,\n",
    "            root_dir=ROOT_DIR,\n",
    "            metadata=metadata,\n",
    "            mode='only_self_train',\n",
    "            top_k=NUM_RETRIEVED,\n",
    "            context_length=context_length,\n",
    "            prediction_length=prediction_length,\n",
    "            seed=SEED,\n",
    "            dimension=768,  # Standard Chronos embedding dimension\n",
    "            embedding_model=embedding_model,\n",
    "            save=True,\n",
    "            embedding_tuning=embedding_tuning,\n",
    "            retrieve_suffix=retrieve_suffix\n",
    "        )\n",
    "    else:\n",
    "        retrieved_df = do_retrieve_X_norm(\n",
    "            original_data_name=dataset_name,\n",
    "            retrieval_database_dir=RETRIEVAL_DATABASE_DIR,\n",
    "            root_dir=ROOT_DIR,\n",
    "            metadata=metadata,\n",
    "            mode='only_self_train',\n",
    "            top_k=NUM_RETRIEVED,\n",
    "            context_length=context_length,\n",
    "            prediction_length=prediction_length,\n",
    "            seed=SEED,\n",
    "            metric=METRIC,\n",
    "            save=True,\n",
    "            retrieve_suffix=retrieve_suffix\n",
    "        )\n",
    "#     else:\n",
    "#         print(f'Loading retrieved data from {retrieved_data_path}')\n",
    "#         retrieved_df = pd.read_csv(retrieved_data_path)\n",
    "    \n",
    "    return retrieved_df"
   ]
