    "# ============================================================================\n",
    "# Retrieval Efficiency Comparison: Z-space vs X-space (both using FAISS)\n",
    "# ============================================================================\n",
    "print(\"=\"*80)\n",
    "print(\"RETRIEVAL EFFICIENCY COMPARISON\")\n",
    "print(\"=\"*80)\n",
    "print(\"Comparing:\")\n",
    "print(\"  Z-space: Embedding computation + FAISS search\")\n",
    "print(\"  X-space: No embedding + FAISS search (on normalized raw time series)\")\n",
    "print(\"=\"*80)\n",
    "\n",
    "retrieval_timings = {}\n",
    "\n",
    "# Z-space retrieval (with embedding)\n",
