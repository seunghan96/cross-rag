    "# Load embedding model for Z-space retrieval (ChronosBolt)\n",
    "from chronos import ChronosPipeline\n",
    "\n",
    "EMBEDDING_MODEL = None\n",
    "EMBEDDING_TUNING = None  # Set to tuning path if using tuned embeddings\n",
    "\n",
    "def get_embedding_model():\n",
    "    \"\"\"Get or create embedding model for Z-space retrieval\"\"\"\n",
    "    global EMBEDDING_MODEL\n",
    "    if EMBEDDING_MODEL is None:\n",
    "        if EMBEDDING_TUNING is None:\n",
    "            model_path = \"amazon/chronos-t5-base\"\n",
    "        else:\n",
    "            model_path = f\"../tuning_results/{metadata['database_name'][0]}_{CONTEXT_LENGTH}_chronos_{EMBEDDING_TUNING}\"\n",
    "            if not os.path.exists(model_path):\n",
    "                print(f'Warning: Tuned embedding model not found at {model_path}, using base model')\n",
    "                model_path = \"amazon/chronos-t5-base\"\n",
    "        \n",
    "        print(f'Loading embedding model from {model_path}')\n",
    "        EMBEDDING_MODEL = ChronosPipeline.from_pretrained(\n",
    "            model_path,\n",
    "            device_map='cuda' if torch.cuda.is_available() else 'cpu',\n",
    "            torch_dtype=torch.bfloat16,\n",
    "        )\n",
    "    return EMBEDDING_MODEL"
   ]
