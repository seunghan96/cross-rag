    "# Initialize models and measure\n",
    "results = {}\n",
    "\n",
    "for idx, (model_class, pipeline_class, model_name) in enumerate(zip(MODELS, PIPELINES, MODEL_NAMES)):\n",
    "    print(f\"\\n{'='*60}\")\n",
    "    print(f\"Processing model: {model_name}\")\n",
    "    print(f\"{'='*60}\")\n",
    "    \n",
    "    try:\n",
    "        # Create model\n",
    "        model = model_class(config=t5_config, augment=augment)\n",
    "        model = model.to(device)\n",
    "        model.eval()\n",
    "        \n",
    "        # Count parameters\n",
    "        total_params = sum(p.numel() for p in model.parameters())\n",
    "        trainable_params = sum(p.numel() for p in model.parameters() if p.requires_grad)\n",
    "        \n",
    "        print(f\"Total parameters: {total_params:,}\")\n",
    "        print(f\"Trainable parameters: {trainable_params:,}\")\n",
    "        \n",
    "        # Create inputs - use dummy data for now (retrieved data integration can be added later if needed)\n",
    "        # First 6 models use X-norm retrieval, ChronosBolt (idx=6) uses Z-space retrieval\n",
    "        # For benchmarking purposes, dummy data is sufficient\n",
    "        context, retrieved_seq, distances = create_dummy_inputs(\n",
    "            BATCH_SIZE, CONTEXT_LENGTH, NUM_RETRIEVED, RETRIEVED_SEQ_LENGTH\n",
    "        )\n",
    "        \n",
    "        # Measure FLOPS\n",
    "        flops = None\n",
    "        if HAS_THOP:\n",
    "            try:\n",
    "                # thop.profile expects a nn.Module object, not a function\n",
    "                # It needs to register forward hooks, which requires .training attribute\n",
    "                # Create a wrapper class that thop can hook into\n",
    "                class ModelWrapper(nn.Module):\n",
    "                    def __init__(self, base_model):\n",
    "                        super().__init__()\n",
    "                        self.model = base_model\n",
    "                    \n",
    "                    def forward(self, context, retrieved_seq, distances):\n",
    "                        return self.model(\n",
    "                            context=context,\n",
    "                            retrieved_seq=retrieved_seq,\n",
    "                            distances=distances\n",
    "                        )\n",
    "                \n",
    "                wrapped_model = ModelWrapper(model)\n",
    "                wrapped_model.eval()  # Ensure eval mode for FLOPS measurement\n",
    "                \n",
    "                flops, params = profile(\n",
    "                    wrapped_model,\n",
    "                    inputs=(context, retrieved_seq, distances),\n",
    "                    verbose=False\n",
    "                )\n",
    "                flops_str = clever_format([flops], \"%.3f\")\n",
    "                print(f\"FLOPS: {flops_str}\")\n",
    "            except Exception as e:\n",
    "                print(f\"FLOPS measurement failed: {e}\")\n",
    "                import traceback\n",
    "                traceback.print_exc()\n",
    "        else:\n",
    "            print(\"FLOPS measurement skipped (thop not available)\")\n",
    "        \n",
    "        # Measure inference time\n",
    "        mean_time, std_time, min_time, max_time, mid_time = measure_inference_time(\n",
    "            model, context, retrieved_seq, distances, num_runs=1000\n",
    "        )\n",
    "        \n",
    "        print(f\"Inference time: {mean_time:.3f} ± {std_time:.3f} ms (min: {min_time:.3f}, max: {max_time:.3f})\")\n",
    "        \n",
    "        # Store results\n",
    "        results[model_name] = {\n",
    "            'total_params': total_params,\n",
    "            'trainable_params': trainable_params,\n",
    "            'flops': flops,\n",
    "            'mean_time_ms': mean_time,\n",
    "            'std_time_ms': std_time,\n",
    "            'mid_time_ms': mid_time,\n",
    "            'min_time_ms': min_time,\n",
    "            'max_time_ms': max_time\n",
    "        }\n",
    "        \n",
    "        # Clean up\n",
    "        del model\n",
    "        if device.type == 'cuda':\n",
    "            torch.cuda.empty_cache()\n",
    "            \n",
    "    except Exception as e:\n",
    "        print(f\"Error processing {model_name}: {e}\")\n",
    "        import traceback\n",
    "        traceback.print_exc()\n",
    "        results[model_name] = {'error': str(e)}"
   ]
